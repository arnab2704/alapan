# Copy to .env.local (apps/web) and .env (database/) and fill in real values.
# Never commit actual secrets.

# --- Database (Postgres / Supabase) ---
# Supabase: Project Settings -> API. The anon key is safe in the browser;
# the service-role key is SERVER-ONLY and must never be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY=
# Only needed for Prisma tooling: Project Settings -> Database -> connection string.
DATABASE_URL="postgresql://postgres:password@db.YOUR-PROJECT.supabase.co:5432/postgres"

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Reserved for later phases (not used by V0.1) ---
# REDIS_URL=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# SENTRY_DSN=
# Optional analytics (off when unset)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
